{
  "name": "ofplens",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm db:up && pnpm db:migrate && pnpm dev:apps",
    "dev:apps": "pnpm --parallel --filter './apps/*' dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "app:up": "docker compose --profile app up --build --wait",
    "app:down": "docker compose --profile app down",
    "app:logs": "docker compose --profile app logs -f api web",
    "db:generate": "pnpm --filter @ofplens/db db:generate",
    "db:migrate": "pnpm --filter @ofplens/db db:migrate",
    "db:studio": "pnpm --filter @ofplens/db db:studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @ofplens/e2e test",
    "e2e:install": "pnpm --filter @ofplens/e2e install-browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixture:capture": "tsx --env-file-if-exists=.env scripts/capture-ofp.ts",
    "fixture:weather": "tsx scripts/capture-weather.ts",
    "fixture:hazards": "tsx scripts/capture-hazards.ts",
    "briefing:try": "tsx --env-file-if-exists=.env packages/agent/scripts/try-briefing.ts",
    "eval": "tsx --env-file-if-exists=.env packages/evals/scripts/run-eval.ts",
    "eval:cases": "tsx --env-file-if-exists=.env packages/evals/scripts/write-cases.ts",
    "eval:stored": "tsx --env-file-if-exists=.env packages/evals/scripts/grade-stored.ts",
    "eval:report": "tsx packages/evals/scripts/build-report.ts",
    "eval:regrade": "tsx packages/evals/scripts/regrade.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
