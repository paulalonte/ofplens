{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OFP Lens chart values",
  "description": "Helm checks the merged values against this on install, upgrade, lint and template. Unknown keys are errors, so a typo (api.replica) fails instead of being silently ignored. Add a key here whenever a template starts reading a new value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "existingSecret",
    "api",
    "web",
    "migrate",
    "ingress",
    "podDisruptionBudget"
  ],
  "definitions": {
    "replicas": { "type": "integer", "minimum": 1 },
    "quantity": {
      "description": "A Kubernetes quantity: 100m, 0.5 or 1 CPUs; 192Mi or 1Gi of memory.",
      "type": ["string", "number"],
      "pattern": "^[0-9.]+(m|Ki|Mi|Gi)?$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": { "$ref": "#/definitions/quantity" },
            "memory": { "$ref": "#/definitions/quantity" }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": { "$ref": "#/definitions/quantity" },
            "memory": { "$ref": "#/definitions/quantity" }
          }
        }
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "api", "web", "tag", "pullPolicy"],
      "properties": {
        "registry": { "type": "string" },
        "api": { "type": "string", "minLength": 1 },
        "web": { "type": "string", "minLength": 1 },
        "tag": {
          "description": "Set per deploy with --set image.tag=...; the templates require it.",
          "type": "string",
          "not": { "const": "latest" }
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "existingSecret": { "type": "string", "minLength": 1 },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "logLevel", "briefingModel", "briefingDailyLimit", "resources"],
      "properties": {
        "replicas": { "$ref": "#/definitions/replicas" },
        "logLevel": { "enum": ["fatal", "error", "warn", "info", "debug", "trace", "silent"] },
        "briefingModel": { "type": "string", "minLength": 1 },
        "briefingDailyLimit": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "resources"],
      "properties": {
        "replicas": { "$ref": "#/definitions/replicas" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "timeoutSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 30 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "host", "annotations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
