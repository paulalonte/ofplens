# Copy to .env (git-ignored). Values match docker-compose.yml.
# Port 5433 so it does not clash with a natively installed Postgres on 5432.
DATABASE_URL=postgres://ofplens:ofplens@localhost:5433/ofplens
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Only for `pnpm fixture:capture` (OFP-05). Your SimBrief Pilot ID, digits only.
SIMBRIEF_PILOT_ID=

# AI briefings (Phase 5). Leave the key empty to switch briefings off.
# Paste your own key here locally; .env is git-ignored. Never commit it or share it.
ANTHROPIC_API_KEY=
BRIEFING_MODEL=claude-haiku-5-5
# Per pilot, and for all pilots together, per rolling 24 hours.
BRIEFING_DAILY_LIMIT=10
BRIEFING_GLOBAL_DAILY_LIMIT=50

# Sign-in (OFP-42, docs/AUTH.md). Where pilots open the app: sign-in callbacks go there.
PUBLIC_URL=http://localhost:5173
# Sign in by typing any name, no password. Development only (refused unless PUBLIC_URL is
# localhost).
DEV_SIGN_IN=true
# Sign in with GitHub / Google: an OAuth app registered for PUBLIC_URL (docs/AUTH.md).
# Paste them here yourself; .env is git-ignored. Each pair, both or neither.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
