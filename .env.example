# Copy to .env (git-ignored). Values match docker-compose.yml.
# Port 5433 so it does not clash with a natively installed Postgres on 5432.
DATABASE_URL=postgres://ofplens:ofplens@localhost:5433/ofplens
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Only for `pnpm fixture:capture` (OFP-05). Your SimBrief Pilot ID, digits only.
SIMBRIEF_PILOT_ID=

# AI briefings (Phase 5). Leave the key empty to switch briefings off.
# Paste your own key here locally; .env is git-ignored. Never commit it or share it.
ANTHROPIC_API_KEY=
BRIEFING_MODEL=claude-haiku-5-5
BRIEFING_DAILY_LIMIT=20
